@page
@model NearGo.Pages.Supermarket.RevenueModel
@{
    ViewData["Title"] = "Doanh thu";
    Layout = "_SupermarketLayout";
}
<div class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700">
            <p class="text-sm text-gray-500 mb-1">Doanh thu thuần</p>
            <p class="text-2xl font-bold text-green-600">@Model.TotalRevenue.ToString("N0")đ</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700">
            <p class="text-sm text-gray-500 mb-1">Tổng doanh thu</p>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.GrossRevenue.ToString("N0")đ</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700">
            <p class="text-sm text-gray-500 mb-1">Đơn đã thanh toán</p>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.PaidOrders</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700">
            <p class="text-sm text-gray-500 mb-1">Phí hoa hồng</p>
            <p class="text-2xl font-bold text-accent-600">@Model.TotalCommission.ToString("N0")đ</p>
        </div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Doanh thu theo tháng</h3>
        <canvas id="monthlyRevenueChart" height="200"></canvas>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var canvas = document.getElementById('monthlyRevenueChart');
        if (!canvas || typeof Chart === 'undefined') return;
        new Chart(canvas, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Model.RevenueChartLabels),
                datasets: [{
                    label: 'Doanh thu',
                    data: @Html.Raw(Model.RevenueChartData),
                    backgroundColor: 'rgba(220,38,38,0.6)',
                    borderColor: '#dc2626',
                    borderWidth: 1,
                    borderRadius: 6,
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { callback: v => v.toLocaleString('vi-VN') + 'đ' } }
                }
            }
        });
    });
</script>
