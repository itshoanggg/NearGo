@page
@model NearGo.Pages.Supermarket.ScanQRModel
@{
    ViewData["Title"] = "Quét mã QR";
    Layout = "_SupermarketLayout";
}
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Xác nhận nhận hàng</h2>
            <p class="text-sm text-gray-500">Quét mã QR hoặc chọn đơn hàng từ danh sách</p>
        </div>
        <button id="toggleScannerBtn" onclick="toggleScanner()" class="px-4 py-2 bg-primary-500 text-white text-sm rounded-xl hover:bg-primary-600 transition-colors">
            <i class="fas fa-camera mr-1"></i> Mở camera
        </button>
    </div>

    <div id="scanner-section" class="hidden">
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
            <p class="text-sm text-gray-500 text-center mb-4">Đưa mã QR của khách hàng vào khung hình</p>
            <div id="qr-reader" class="w-full max-w-sm mx-auto rounded-xl overflow-hidden border border-gray-200 dark:border-gray-600"></div>

            <div id="scan-result" class="mt-4 hidden">
                <div class="p-4 bg-green-50 dark:bg-green-900/20 rounded-xl text-center">
                    <p class="text-green-700 dark:text-green-300 font-semibold" id="result-text"></p>
                    <a id="confirm-link" href="" class="mt-2 inline-block px-4 py-2 bg-green-600 text-white text-sm rounded-xl hover:bg-green-700 transition-colors">
                        Xác nhận nhận hàng
                    </a>
                </div>
            </div>

            <div id="scan-error" class="mt-4 hidden">
                <div class="p-4 bg-red-50 dark:bg-red-900/20 rounded-xl text-center">
                    <p class="text-red-700 dark:text-red-300 font-semibold" id="error-text"></p>
                </div>
            </div>

            <div class="mt-4 text-center">
                <button onclick="stopScanner()" class="px-4 py-2 border border-gray-200 dark:border-gray-600 text-gray-500 text-sm rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                    <i class="fas fa-stop mr-1"></i> Dừng quét
                </button>
            </div>
        </div>
    </div>

    @if (Model.ScannedOrder != null)
    {
        <div class="bg-blue-50 dark:bg-blue-900/20 rounded-2xl p-6 border border-blue-100 dark:border-blue-800">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-sm font-semibold text-blue-900 dark:text-blue-300">
                    <i class="fas fa-search mr-1"></i> Tra cứu: #@Model.ScannedOrder.OrderCode
                </h3>
                <span class="px-2 py-0.5 rounded-full text-xs font-medium @(Model.ScannedOrder.PaymentStatus == "Paid" ? "bg-green-100 text-green-600" : "bg-yellow-100 text-yellow-600")">
                    @(Model.ScannedOrder.PaymentStatus == "Paid" ? "Đã thanh toán" : "Chưa thanh toán")
                </span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
                <div>
                    <p class="text-blue-600 dark:text-blue-400">Khách hàng</p>
                    <p class="font-medium text-gray-900 dark:text-white">@(Model.ScannedOrder.CustomerName ?? Model.ScannedOrder.Customer?.FullName)</p>
                </div>
                <div>
                    <p class="text-blue-600 dark:text-blue-400">Số điện thoại</p>
                    <p class="font-medium text-gray-900 dark:text-white">@(Model.ScannedOrder.CustomerPhone ?? Model.ScannedOrder.Customer?.PhoneNumber)</p>
                </div>
                <div>
                    <p class="text-blue-600 dark:text-blue-400">Tổng tiền</p>
                    <p class="font-medium text-gray-900 dark:text-white">@Model.ScannedOrder.TotalAmount.ToString("N0")đ</p>
                </div>
                <div class="flex items-end justify-end">
                    <form method="post" asp-page-handler="ReceiveOrder" onsubmit="return confirmReceive(event, '@Model.ScannedOrder.Id', '@Model.ScannedOrder.OrderCode', '@Model.ScannedOrder.TotalAmount.ToString("N0")', '@Model.ScannedOrder.PaymentStatus')">
                        <input type="hidden" name="id" value="@Model.ScannedOrder.Id" />
                        <button type="submit" class="px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-xl hover:bg-green-700 transition-colors">
                            <i class="fas fa-check mr-1"></i> Nhận hàng
                        </button>
                    </form>
                </div>
            </div>
            <div class="mt-3 flex flex-wrap gap-2">
                @foreach (var item in Model.ScannedOrder.OrderItems)
                {
                    <span class="px-2 py-1 text-xs bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-lg">
                        @item.Product.Name x@(item.Quantity)
                    </span>
                }
            </div>
        </div>
    }

    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="p-4 border-b border-gray-100 dark:border-gray-700">
            <h3 class="text-sm font-semibold text-gray-900 dark:text-white">
                <i class="fas fa-list mr-1"></i> Đơn hàng chờ nhận (@Model.ConfirmedOrders.Count)
            </h3>
        </div>
        @if (Model.ConfirmedOrders.Count == 0)
        {
            <div class="p-8 text-center">
                <p class="text-gray-400">Không có đơn hàng nào đang chờ nhận</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-gray-100 dark:divide-gray-700">
                @foreach (var order in Model.ConfirmedOrders)
                {
                    <div class="p-4 flex flex-col sm:flex-row sm:items-center gap-4">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="text-sm font-semibold text-gray-900 dark:text-white">#@order.OrderCode</span>
                                <span class="px-2 py-0.5 rounded-full text-xs font-medium @(order.PaymentStatus == "Paid" ? "bg-green-100 text-green-600" : "bg-yellow-100 text-yellow-600")">
                                    @(order.PaymentStatus == "Paid" ? "Đã thanh toán" : "Tiền mặt")
                                </span>
                            </div>
                            <p class="text-sm text-gray-500">
                                @(order.CustomerName ?? order.Customer?.FullName)
                                @if (!string.IsNullOrEmpty(order.CustomerPhone))
                                {
                                    <span class="mx-1">·</span> @order.CustomerPhone
                                }
                            </p>
                            <p class="text-xs text-gray-400 mt-1">
                                @string.Join(", ", order.OrderItems.Select(i => i.Product.Name + " x" + i.Quantity))
                            </p>
                            <p class="text-sm text-gray-400 mt-1">
                                @order.OrderDate.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")
                            </p>
                        </div>
                        <div class="text-right flex-shrink-0">
                            <p class="text-sm font-semibold text-gray-900 dark:text-white">@order.TotalAmount.ToString("N0")đ</p>
                            @if (order.PaymentStatus == "Unpaid")
                            {
                                <p class="text-xs text-yellow-600">Cần thu: @order.TotalAmount.ToString("N0")đ</p>
                            }
                        </div>
                        <form method="post" asp-page-handler="ReceiveOrder" onsubmit="return confirmReceive(event, '@order.Id', '@order.OrderCode', '@order.TotalAmount.ToString("N0")', '@order.PaymentStatus')">
                            <input type="hidden" name="id" value="@order.Id" />
                            <button type="submit" class="w-full sm:w-auto px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-xl hover:bg-green-700 transition-colors whitespace-nowrap">
                                <i class="fas fa-check mr-1"></i> Nhận hàng
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (TempData["ConfirmPayment"] != null)
{
    <div id="paymentModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50">
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 max-w-sm w-full mx-4 shadow-xl">
            <div class="text-center">
                <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-yellow-100 dark:bg-yellow-900/30 flex items-center justify-center">
                    <i class="fas fa-money-bill-wave text-2xl text-yellow-600"></i>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Xác nhận thanh toán</h3>
                <p class="text-sm text-gray-500 mb-4">Khách hàng chưa thanh toán đơn hàng này. Vui lòng thu số tiền:</p>
                <p class="text-3xl font-bold text-primary-600 mb-6">@TempData["ConfirmAmount"]₫</p>
                <div class="flex gap-3">
                    <a href="/supermarket/scanqr" class="flex-1 px-4 py-2.5 border border-gray-200 dark:border-gray-600 text-gray-500 text-sm font-medium rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors text-center">
                        Huỷ
                    </a>
                    <form method="post" asp-page-handler="ReceiveOrder" class="flex-1">
                        <input type="hidden" name="id" value="@TempData["ConfirmPayment"]" />
                        <input type="hidden" name="confirmPayment" value="true" />
                        <button type="submit" class="w-full px-4 py-2.5 bg-primary-600 text-white text-sm font-medium rounded-xl hover:bg-primary-700 transition-colors">
                            Đã thu @TempData["ConfirmAmount"]₫
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script>
        let html5QrCode = null;
        let scannerActive = false;

        function toggleScanner() {
            const section = document.getElementById('scanner-section');
            const btn = document.getElementById('toggleScannerBtn');
            if (scannerActive) {
                stopScanner();
            } else {
                section.classList.remove('hidden');
                btn.innerHTML = '<i class="fas fa-times mr-1"></i> Đóng camera';
                startScanner();
            }
        }

        function startScanner() {
            const reader = document.getElementById('qr-reader');
            reader.innerHTML = '';

            html5QrCode = new Html5Qrcode("qr-reader");
            html5QrCode.start(
                { facingMode: "environment" },
                { fps: 10, qrbox: { width: 250, height: 250 } },
                onScanSuccess
            ).catch(err => {
                showError('Không thể truy cập camera: ' + err);
            });
            scannerActive = true;
        }

        function stopScanner() {
            if (html5QrCode) {
                html5QrCode.stop().then(() => {
                    html5QrCode.clear();
                });
            }
            const section = document.getElementById('scanner-section');
            section.classList.add('hidden');
            const btn = document.getElementById('toggleScannerBtn');
            btn.innerHTML = '<i class="fas fa-camera mr-1"></i> Mở camera';
            scannerActive = false;
        }

        function onScanSuccess(decodedText) {
            stopScanner();
            window.location.href = '/supermarket/scanqr?code=' + encodeURIComponent(decodedText);
        }

        function showError(msg) {
            const errorDiv = document.getElementById('scan-error');
            errorDiv.classList.remove('hidden');
            document.getElementById('error-text').textContent = msg;
        }

        function confirmReceive(event, orderId, orderCode, amount, paymentStatus) {
            if (paymentStatus === 'Paid') {
                return confirm('Xác nhận nhận hàng cho đơn #' + orderCode + '?');
            }
            return true;
        }
    </script>
}
