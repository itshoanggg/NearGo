@page
@model NearGo.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Sản phẩm";
}
<div class="max-w-7xl mx-auto px-4 py-6">
    <div class="flex flex-col md:flex-row gap-6">
        <aside class="w-full md:w-64 shrink-0">
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-5 sticky top-20">
                <h3 class="font-semibold text-gray-900 dark:text-white mb-4">Bộ lọc</h3>
                <form method="get" id="filterForm">
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Danh mục</label>
                        <select name="category" class="w-full px-3 py-2 border border-gray-200 dark:border-gray-600 rounded-xl bg-gray-50 dark:bg-gray-700 text-sm focus:ring-2 focus:ring-primary-500 outline-none" onchange="this.form.submit()">
                            <option value="">Tất cả</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Slug" selected="@(Model.CategorySlug == cat.Slug)">@cat.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Khu vực</label>
                        <input type="text" name="area" value="@Model.Area" placeholder="Nhập khu vực (Quận, TP...)" class="w-full px-3 py-2 border border-gray-200 dark:border-gray-600 rounded-xl bg-gray-50 dark:bg-gray-700 text-sm focus:ring-2 focus:ring-primary-500 outline-none" />
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Sắp xếp</label>
                        <select name="sort" class="w-full px-3 py-2 border border-gray-200 dark:border-gray-600 rounded-xl bg-gray-50 dark:bg-gray-700 text-sm focus:ring-2 focus:ring-primary-500 outline-none" onchange="this.form.submit()">
                            <option value="newest" selected="@(Model.Sort == "newest")">Mới nhất</option>
                            <option value="price-asc" selected="@(Model.Sort == "price-asc")">Giá thấp đến cao</option>
                            <option value="price-desc" selected="@(Model.Sort == "price-desc")">Giá cao đến thấp</option>
                            <option value="discount" selected="@(Model.Sort == "discount")">Giảm nhẹ</option>
                            <option value="expiry" selected="@(Model.Sort == "expiry")">Giảm sâu</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Khoảng giá</label>
                        <div class="flex gap-2">
                            <input type="number" name="minPrice" value="@Model.MinPrice" placeholder="Từ" class="w-1/2 px-3 py-2 border border-gray-200 dark:border-gray-600 rounded-xl bg-gray-50 dark:bg-gray-700 text-sm focus:ring-2 focus:ring-primary-500 outline-none" />
                            <input type="number" name="maxPrice" value="@Model.MaxPrice" placeholder="Đến" class="w-1/2 px-3 py-2 border border-gray-200 dark:border-gray-600 rounded-xl bg-gray-50 dark:bg-gray-700 text-sm focus:ring-2 focus:ring-primary-500 outline-none" />
                        </div>
                    </div>
                    <button type="submit" class="w-full py-2.5 bg-primary-500 text-white text-sm font-medium rounded-xl hover:bg-primary-600 transition-colors">Áp dụng</button>
                    <a href="/products" class="block text-center mt-2 py-2 text-sm text-gray-500 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400">Xóa bộ lọc</a>
                </form>
            </div>
        </aside>
        <div class="flex-1">
            <div class="flex items-center justify-between mb-4">
                <h1 class="text-xl font-bold text-gray-900 dark:text-white">
                    @if (!string.IsNullOrEmpty(Model.CategoryName))
                    {
                        @Model.CategoryName
                    }
                    else
                    {
                        <text>Tất cả sản phẩm</text>
                    }
                </h1>
                <span class="text-sm text-gray-500 dark:text-gray-400">@Model.TotalCount sản phẩm</span>
            </div>
            <div class="flex gap-2 mb-4 flex-wrap">
                <a href="/products" class="px-4 py-1.5 text-sm rounded-full font-medium transition-all @(string.IsNullOrEmpty(Model.Sort) ? "bg-primary-500 text-white shadow-md" : "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600")">Tất cả</a>
                <a href="/products?sort=discount" class="px-4 py-1.5 text-sm rounded-full font-medium transition-all @(Model.Sort == "discount" ? "bg-primary-500 text-white shadow-md" : "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600")"><i class="fas fa-tag mr-1"></i>Giảm nhẹ</a>
                <a href="/products?sort=expiry" class="px-4 py-1.5 text-sm rounded-full font-medium transition-all @(Model.Sort == "expiry" ? "bg-red-500 text-white shadow-md" : "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600")"><i class="fas fa-hourglass-half mr-1"></i>Giảm sâu</a>
            </div>
            @if (!string.IsNullOrEmpty(Model.SearchQuery))
            {
                <div class="mb-4 p-3 bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-200 rounded-xl text-sm">
                    Kết quả tìm kiếm cho "<strong>@Model.SearchQuery</strong>"
                </div>
            }
            @if (!Model.Products.Any())
            {
                <div class="text-center py-16">
                    <div class="w-20 h-20 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-box-open text-3xl text-gray-400 dark:text-gray-500"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">Không tìm thấy sản phẩm</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Thử thay đổi bộ lọc hoặc tìm kiếm khác</p>
                </div>
            }
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                @foreach (var product in Model.Products)
                {
                    var isGiamNhe = product.DiscountEndDate.HasValue && product.DiscountEndDate > DateTime.UtcNow;
                    var isGiamSau = !isGiamNhe && product.ExpiryDate <= DateTime.UtcNow.AddDays(30);
                    <div class="bg-white dark:bg-gray-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 group border border-gray-100 dark:border-gray-700">
                        <div class="relative overflow-hidden">
                            <a href="/products/detail?id=@product.Id">
                                <img src="@product.ImageUrl" alt="@product.Name" class="w-full h-40 object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                            </a>
                            <div class="absolute top-2 left-2 flex flex-col gap-1">
                                @if (product.DiscountPercentage > 0)
                                {
                                    <span class="bg-red-500 text-white text-xs font-bold px-2 py-0.5 rounded-lg">-@((int)product.DiscountPercentage)%</span>
                                }
                                @if (isGiamSau)
                                {
                                    <span class="bg-amber-500 text-white text-xs font-bold px-2 py-0.5 rounded-lg animate-pulse">Giảm sâu</span>
                                }
                            </div>
                        </div>
                        <div class="p-3">
                            <a href="/products/detail?id=@product.Id">
                                <h3 class="text-sm font-semibold text-gray-900 dark:text-white truncate hover:text-primary-600 dark:hover:text-primary-400 transition-colors">@product.Name</h3>
                            </a>
                            <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">@product.Supermarket?.Name</p>
                            <div class="flex items-center gap-2 mt-2">
                                <span class="text-base font-bold text-gray-900 dark:text-white">@product.DiscountedPrice.ToString("N0")đ</span>
                                @if (product.DiscountPercentage > 0)
                                {
                                    <span class="text-xs text-gray-400 dark:text-gray-500 line-through">@product.OriginalPrice.ToString("N0")đ</span>
                                }
                            </div>
                            <div class="mt-1">
                                @if (isGiamNhe)
                                {
                                    <span class="inline-block text-xs text-primary-600 font-medium bg-primary-50 dark:bg-primary-900/20 px-2 py-0.5 rounded-full">
                                        <i class="fas fa-tag mr-0.5"></i>Giảm nhẹ - đến @product.DiscountEndDate!.Value.ToString("dd/MM")
                                    </span>
                                }
                                else if (isGiamSau)
                                {
                                    var daysLeft = Math.Max(1, (int)(product.ExpiryDate - DateTime.UtcNow).TotalDays);
                                    <span class="inline-block text-xs text-amber-600 font-medium bg-amber-50 dark:bg-amber-900/20 px-2 py-0.5 rounded-full animate-pulse">
                                        <i class="fas fa-hourglass-half mr-0.5"></i>Giảm sâu - còn @daysLeft ngày
                                    </span>
                                }
                            </div>
                            <div class="flex items-center justify-between mt-2">
                                <button onclick="addToCart(@product.Id)" class="w-8 h-8 bg-accent-500 text-gray-900 rounded-lg hover:bg-accent-600 transition-all shadow-sm shadow-accent-500/30 ml-auto">
                                    <i class="fas fa-plus text-xs"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
            @if (Model.TotalPages > 1)
            {
                <div class="flex items-center justify-center gap-2 mt-8">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Url.Page("Index", new { p = Model.CurrentPage - 1, category = Model.CategorySlug, area = Model.Area, sort = Model.Sort, search = Model.SearchQuery, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice })" class="px-4 py-2 text-sm bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    }
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <a href="@Url.Page("Index", new { p = i, category = Model.CategorySlug, area = Model.Area, sort = Model.Sort, search = Model.SearchQuery, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice })" class="px-4 py-2 text-sm rounded-xl @(i == Model.CurrentPage ? "bg-primary-500 text-white" : "bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700") transition-colors">
                            @i
                        </a>
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Url.Page("Index", new { p = Model.CurrentPage + 1, category = Model.CategorySlug, area = Model.Area, sort = Model.Sort, search = Model.SearchQuery, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice })" class="px-4 py-2 text-sm bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>
