@page
@model NearGo.Pages.Customer.Reports.CreateModel
@{
    ViewData["Title"] = "Báo cáo siêu thị";
    Layout = "_CustomerLayout";
}
<div class="max-w-2xl mx-auto">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Báo cáo siêu thị</h2>
        <p class="text-sm text-gray-500 mb-6">Sử dụng form này để báo cáo siêu thị có hành vi không minh bạch hoặc vi phạm quy định.</p>
        <form method="post">
            <div class="mb-4">
                <label for="supermarketId" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Siêu thị</label>
                <select id="supermarketId" name="supermarketId" class="w-full px-3 py-2 border border-gray-200 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 outline-none text-sm">
                    <option value="">-- Chọn siêu thị --</option>
                    @foreach (var sm in Model.Supermarkets)
                    {
                        <option value="@sm.Id">@sm.Name</option>
                    }
                </select>
            </div>
            <div class="mb-4">
                <label for="title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Tiêu đề</label>
                <input id="title" name="title" type="text" required class="w-full px-3 py-2 border border-gray-200 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 outline-none text-sm" placeholder="Ví dụ: Hàng giả, gian lận giá..." />
            </div>
            <div class="mb-6">
                <label for="description" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Nội dung chi tiết</label>
                <textarea id="description" name="description" rows="6" required class="w-full px-3 py-2 border border-gray-200 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 outline-none text-sm" placeholder="Mô tả chi tiết vấn đề bạn gặp phải..."></textarea>
            </div>
            <div class="flex items-center gap-3">
                <button type="submit" class="px-6 py-2.5 bg-primary-600 text-white text-sm font-medium rounded-xl hover:bg-primary-700 transition-colors">
                    <i class="fas fa-paper-plane mr-1"></i> Gửi báo cáo
                </button>
                <a href="/customer/reports" class="px-6 py-2.5 text-sm text-gray-600 dark:text-gray-300 hover:underline">Hủy</a>
            </div>
        </form>
    </div>
</div>
