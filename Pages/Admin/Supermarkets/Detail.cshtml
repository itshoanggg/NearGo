@page
@model NearGo.Pages.Admin.Supermarkets.DetailModel
@{
    ViewData["Title"] = Model.Supermarket.Name;
    Layout = "_AdminLayout";
}
<div class="space-y-6">
    <a href="/admin/supermarkets" class="text-sm text-primary-500 hover:text-primary-600">
        <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách
    </a>

    <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
        <div class="flex items-start gap-4">
            <img src="@Model.Supermarket.LogoUrl" alt="@Model.Supermarket.Name" class="w-16 h-16 rounded-xl object-cover" />
            <div class="flex-1">
                <div class="flex items-center gap-3 mb-1">
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white">@Model.Supermarket.Name</h2>
                    <span class="px-2 py-0.5 rounded-full text-xs @(Model.Supermarket.IsActive ? "bg-green-100 text-green-600" : "bg-red-100 text-red-600")">
                        @(Model.Supermarket.IsActive ? "Hoạt động" : "Đã khóa")
                    </span>
                </div>
                <p class="text-sm text-gray-500">@Model.Supermarket.Email</p>
                @if (!string.IsNullOrEmpty(Model.Supermarket.Address))
                {
                    <p class="text-sm text-gray-500"><i class="fas fa-map-marker-alt mr-1"></i>@Model.Supermarket.Address</p>
                }
                @if (!string.IsNullOrEmpty(Model.Supermarket.Phone))
                {
                    <p class="text-sm text-gray-500"><i class="fas fa-phone mr-1"></i>@Model.Supermarket.Phone</p>
                }
                <p class="text-sm text-gray-500 mt-1"><i class="fas fa-star text-yellow-400 mr-1"></i> @Model.Supermarket.Rating.ToString("0.0") (@Model.Supermarket.ReviewCount đánh giá)</p>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700">
            <p class="text-xs text-gray-500 mb-1">Số dư ví</p>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.Supermarket.Balance.ToString("N0")đ</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700">
            <p class="text-xs text-gray-500 mb-1">Tổng doanh thu</p>
            <p class="text-2xl font-bold text-green-600">@Model.Supermarket.TotalRevenue.ToString("N0")đ</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700">
            <p class="text-xs text-gray-500 mb-1">Phí hoa hồng đã nộp</p>
            <p class="text-2xl font-bold text-accent-600">@Model.TotalCommissionPaid.ToString("N0")đ</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700">
            <p class="text-xs text-gray-500 mb-1">Đơn đã thanh toán</p>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.TotalPaidOrders</p>
        </div>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Doanh thu theo tháng</h3>
            <canvas id="revenueChart" height="200"></canvas>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Đơn hàng gần đây</h3>
            @if (Model.RecentOrders.Any())
            {
                <div class="space-y-3">
                    @foreach (var order in Model.RecentOrders)
                    {
                        <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700/50 rounded-xl">
                            <div>
                                <p class="text-sm font-medium text-gray-900 dark:text-white">#@order.OrderCode</p>
                                <p class="text-xs text-gray-500">@order.Customer?.FullName</p>
                            </div>
                            <div class="text-right">
                                <p class="text-sm font-bold text-gray-900 dark:text-white">@order.TotalAmount.ToString("N0")đ</p>
                                <span class="text-xs px-2 py-0.5 rounded-full @(order.PaymentStatus == "Paid" ? "bg-green-100 text-green-600" : "bg-yellow-100 text-yellow-600")">
                                    @(order.PaymentStatus == "Paid" ? "Đã TT" : "Chưa TT")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-sm text-gray-400 text-center py-8">Chưa có đơn hàng</p>
            }
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Thông tin khác</h3>
        <div class="grid grid-cols-2 gap-4 text-sm">
            <div>
                <p class="text-gray-400">Số sản phẩm</p>
                <p class="text-gray-900 dark:text-white font-medium">@Model.Supermarket.Products.Count</p>
            </div>
            <div>
                <p class="text-gray-400">Tổng đơn hàng</p>
                <p class="text-gray-900 dark:text-white font-medium">@Model.Supermarket.TotalOrders</p>
            </div>

        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var canvas = document.getElementById('revenueChart');
        if (!canvas || typeof Chart === 'undefined') return;
        new Chart(canvas, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Model.RevenueChartLabels),
                datasets: [{
                    label: 'Doanh thu',
                    data: @Html.Raw(Model.RevenueChartData),
                    backgroundColor: 'rgba(2,132,199,0.6)',
                    borderColor: '#0284c7',
                    borderWidth: 1,
                    borderRadius: 6,
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { callback: v => v.toLocaleString('vi-VN') + 'đ' } }
                }
            }
        });
    });
</script>
