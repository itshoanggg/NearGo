@page
@model NearGo.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}
<div class="space-y-6">
    <div class="bg-gradient-to-r from-primary-600 via-primary-500 to-accent-500 rounded-2xl p-6 text-gray-900 dark:text-white">
        <h2 class="text-xl font-bold">Admin Dashboard</h2>
        <p class="text-gray-600 dark:text-white/70 text-sm mt-1">Quản lý nền tảng NearGo</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
                <div class="w-11 h-11 bg-primary-50 dark:bg-primary-900/20 rounded-xl flex items-center justify-center"><i class="fas fa-users text-primary-500"></i></div>
            </div>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.TotalUsers</p>
            <p class="text-xs text-gray-500">Người dùng</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
                <div class="w-11 h-11 bg-green-50 dark:bg-green-900/20 rounded-xl flex items-center justify-center"><i class="fas fa-store text-green-500"></i></div>
            </div>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.TotalSupermarkets</p>
            <p class="text-xs text-gray-500">Siêu thị</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700">
            <div class="w-11 h-11 bg-accent-50 dark:bg-accent-900/20 rounded-xl flex items-center justify-center mb-3"><i class="fas fa-shopping-bag text-accent-500"></i></div>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.TotalOrders</p>
            <p class="text-xs text-gray-500">Đơn hàng</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-700">
            <div class="w-11 h-11 bg-purple-50 dark:bg-purple-900/20 rounded-xl flex items-center justify-center mb-3"><i class="fas fa-dollar-sign text-purple-500"></i></div>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.TotalRevenue.ToString("N0")đ</p>
            <p class="text-xs text-gray-500">Doanh thu nền tảng</p>
        </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        <div class="bg-gradient-to-br from-green-50 to-green-100 dark:from-green-900/20 dark:to-green-900/10 rounded-2xl p-5 border border-green-200 dark:border-green-800">
            <p class="text-xs text-green-600 dark:text-green-400 font-medium">Tổng tiền trong ví siêu thị</p>
            <p class="text-2xl font-bold text-green-700 dark:text-green-300">@Model.TotalSupermarketBalance.ToString("N0")đ</p>
            <p class="text-xs text-green-600 dark:text-green-500 mt-1">Số tiền nền tảng đang giữ hộ</p>
        </div>
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-900/20 dark:to-blue-900/10 rounded-2xl p-5 border border-blue-200 dark:border-blue-800">
            <p class="text-xs text-blue-600 dark:text-blue-400 font-medium">Doanh thu nền tảng (hoa hồng)</p>
            <p class="text-2xl font-bold text-blue-700 dark:text-blue-300">@Model.TotalPlatformBalance.ToString("N0")đ</p>
            <p class="text-xs text-blue-600 dark:text-blue-500 mt-1">Đã thu từ phí hoa hồng</p>
        </div>
        <div class="bg-gradient-to-br from-amber-50 to-amber-100 dark:from-amber-900/20 dark:to-amber-900/10 rounded-2xl p-5 border border-amber-200 dark:border-amber-800">
            <p class="text-xs text-amber-600 dark:text-amber-400 font-medium">Yêu cầu rút tiền</p>
            <p class="text-2xl font-bold text-amber-700 dark:text-amber-300">@Model.PendingWithdrawals</p>
            <p class="text-xs text-amber-600 dark:text-amber-500 mt-1">Đang chờ xét duyệt</p>
        </div>
    </div>

    @if (Model.RevenueBySupermarket.Any())
    {
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Số dư theo siêu thị</h3>
            <div class="space-y-3">
                @foreach (var kv in Model.RevenueBySupermarket)
                {
                    <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700/50 rounded-xl">
                        <span class="text-sm font-medium text-gray-900 dark:text-white">@kv.Key</span>
                        <span class="text-sm font-bold text-gray-900 dark:text-white">@kv.Value.ToString("N0")đ</span>
                    </div>
                }
            </div>
        </div>
    }

    <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 md:col-span-2">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Người dùng mới đăng ký</h3>
                <a href="/admin/users" class="text-sm text-primary-500 hover:text-primary-600">Xem tất cả</a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-gray-500 border-b border-gray-100 dark:border-gray-700">
                            <th class="pb-3 font-medium">Người dùng</th>
                            <th class="pb-3 font-medium">Email</th>
                            <th class="pb-3 font-medium">Số điện thoại</th>
                            <th class="pb-3 font-medium">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.RecentUsers)
                        {
                            <tr class="border-b border-gray-50 dark:border-gray-800">
                                <td class="py-3">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center text-primary-500 font-semibold text-xs">
                                            @(user.FullName?.Substring(0, 1) ?? "?")
                                        </div>
                                        <span class="text-gray-900 dark:text-white font-medium">@(user.FullName ?? user.UserName)</span>
                                    </div>
                                </td>
                                <td class="py-3 text-gray-500">@user.Email</td>
                                <td class="py-3 text-gray-500">@(user.PhoneNumber ?? "—")</td>
                                <td class="py-3">
                                    <span class="px-2 py-0.5 rounded-full text-xs @(user.IsActive ? "bg-green-100 text-green-600" : "bg-red-100 text-red-600")">
                                        @(user.IsActive ? "Hoạt động" : "Đã khóa")
                                    </span>
                                </td>
                            </tr>
                        }
                        @if (!Model.RecentUsers.Any())
                        {
                            <tr><td colspan="4" class="py-8 text-center text-gray-400">Chưa có người dùng nào</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Phân bố người dùng</h3>
            <canvas id="roleChart" height="220"></canvas>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 md:col-span-2">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Siêu thị nổi bật</h3>
                <a href="/admin/supermarkets" class="text-sm text-primary-500 hover:text-primary-600">Xem tất cả</a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-gray-500 border-b border-gray-100 dark:border-gray-700">
                            <th class="pb-3 font-medium">Siêu thị</th>
                            <th class="pb-3 font-medium">Gói</th>
                            <th class="pb-3 font-medium">Đánh giá</th>
                            <th class="pb-3 font-medium">Đơn hàng</th>
                            <th class="pb-3 font-medium">Số dư</th>
                            <th class="pb-3 font-medium">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sm in Model.TopSupermarkets)
                        {
                            <tr class="border-b border-gray-50 dark:border-gray-800">
                                <td class="py-3">
                                    <div class="flex items-center gap-3">
                                        <img src="@sm.LogoUrl" alt="@sm.Name" class="w-8 h-8 rounded-lg object-cover" />
                                        <span class="text-gray-900 dark:text-white font-medium">@sm.Name</span>
                                    </div>
                                </td>
                                <td class="py-3"><span class="px-2 py-0.5 rounded-full text-xs bg-primary-50 dark:bg-primary-900/20 text-primary-600">@sm.SubscriptionTier</span></td>
                                <td class="py-3"><div class="flex items-center gap-1">@sm.Rating.ToString("0.0") <i class="fas fa-star text-yellow-400 text-xs"></i></div></td>
                                <td class="py-3 text-gray-500">@sm.TotalOrders</td>
                                <td class="py-3 text-gray-900 dark:text-white font-medium">@sm.Balance.ToString("N0")đ</td>
                                <td class="py-3">
                                    <span class="px-2 py-0.5 rounded-full text-xs @(sm.IsActive ? "bg-green-100 text-green-600" : "bg-red-100 text-red-600")">
                                        @(sm.IsActive ? "Hoạt động" : "Tạm dừng")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var roleCanvas = document.getElementById('roleChart');
        if (roleCanvas && typeof Chart !== 'undefined') {
            new Chart(roleCanvas, {
                type: 'doughnut',
                data: {
                    labels: ['Khách hàng', 'Siêu thị', 'Admin'],
                    datasets: [{
                        data: [@Model.TotalUsers, @Model.TotalSupermarkets, 1],
                        backgroundColor: ['#0ea5e9', '#f59e0b', '#8b5cf6'],
                        borderWidth: 0,
                    }]
                },
                options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
            });
        }
    });
</script>
