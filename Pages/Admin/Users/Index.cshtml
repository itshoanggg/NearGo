@page
@model NearGo.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "_AdminLayout";
}
<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Người dùng (@Model.TotalCount)</h2>
        <div class="flex flex-wrap items-center gap-2">
            <form method="get" class="flex items-center gap-2">
                <input type="text" name="search" value="@Model.Search" placeholder="Tìm tên, email, SĐT..."
                       class="px-3 py-1.5 text-sm border border-gray-200 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 outline-none w-48" />
                <button type="submit" class="px-3 py-1.5 text-sm bg-primary-500 text-white rounded-lg hover:bg-primary-600">
                    <i class="fas fa-search"></i>
                </button>
            </form>
            <div class="flex gap-1">
                <a href="/admin/users" class="px-3 py-1.5 text-sm rounded-lg @(string.IsNullOrEmpty(Model.Filter) ? "bg-primary-500 text-white" : "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300")">Tất cả</a>
                <a href="/admin/users?filter=active" class="px-3 py-1.5 text-sm rounded-lg @(Model.Filter == "active" ? "bg-green-500 text-white" : "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300")">Hoạt động</a>
                <a href="/admin/users?filter=inactive" class="px-3 py-1.5 text-sm rounded-lg @(Model.Filter == "inactive" ? "bg-red-500 text-white" : "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300")">Đã khóa</a>
            </div>
        </div>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="text-left text-gray-500 border-b border-gray-100 dark:border-gray-700">
                    <th class="pb-3 font-medium">Người dùng</th>
                    <th class="pb-3 font-medium">Email</th>
                    <th class="pb-3 font-medium">Số điện thoại</th>
                    <th class="pb-3 font-medium">Trạng thái</th>
                    <th class="pb-3 font-medium">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Users.Any())
                {
                    <tr><td colspan="5" class="py-8 text-center text-gray-400">Không có người dùng nào</td></tr>
                }
                @foreach (var user in Model.Users)
                {
                    <tr class="border-b border-gray-50 dark:border-gray-800">
                        <td class="py-3">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center text-primary-500 font-semibold text-xs">
                                    @(user.FullName?.Substring(0, 1) ?? "?")
                                </div>
                                <span class="text-gray-900 dark:text-white font-medium">@(user.FullName ?? user.UserName)</span>
                            </div>
                        </td>
                        <td class="py-3 text-gray-500">@user.Email</td>
                        <td class="py-3 text-gray-500">@(user.PhoneNumber ?? "—")</td>
                        <td class="py-3">
                            <span class="px-2 py-0.5 rounded-full text-xs @(user.IsActive ? "bg-green-100 text-green-600" : "bg-red-100 text-red-600")">
                                @(user.IsActive ? "Hoạt động" : "Đã khóa")
                            </span>
                        </td>
                        <td class="py-3">
                            <div class="flex items-center gap-1">
                                <a href="/admin/users/detail?id=@user.Id" class="px-2 py-1 text-xs rounded-lg bg-blue-100 text-blue-700 hover:bg-blue-200 transition-colors">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-between mt-4">
            <span class="text-sm text-gray-500">Tổng số @Model.TotalCount người dùng</span>
            <div class="flex gap-1">
                @if (Model.CurrentPage > 1)
                {
                    <a href="/admin/users?filter=@Model.Filter&search=@Model.Search&p=@(Model.CurrentPage - 1)" class="px-3 py-1.5 text-sm rounded-lg bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600">&laquo;</a>
                }
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a href="/admin/users?filter=@Model.Filter&search=@Model.Search&p=@i" class="px-3 py-1.5 text-sm rounded-lg @(i == Model.CurrentPage ? "bg-primary-500 text-white" : "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600")">@i</a>
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="/admin/users?filter=@Model.Filter&search=@Model.Search&p=@(Model.CurrentPage + 1)" class="px-3 py-1.5 text-sm rounded-lg bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600">&raquo;</a>
                }
            </div>
        </div>
    }
</div>
