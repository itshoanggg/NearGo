@page
@model NearGo.Pages.Admin.CategoriesModel
@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "_AdminLayout";
}
<style>
    .modal-overlay { display: none; }
    .modal-overlay.show { display: flex; }
</style>
@if (TempData["Success"] != null)
{
    <div class="mb-4 p-3 bg-green-100 text-green-700 rounded-lg text-sm">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 p-3 bg-red-100 text-red-700 rounded-lg text-sm">@TempData["Error"]</div>
}
<div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Danh mục (@Model.Categories.Count)</h2>
        <button onclick="showModal()" class="px-3 py-1.5 text-sm bg-primary-500 text-white rounded-lg hover:bg-primary-600">
            <i class="fas fa-plus"></i> Thêm danh mục
        </button>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="text-left text-gray-500 border-b border-gray-100 dark:border-gray-700">
                    <th class="pb-3 font-medium w-10">Icon</th>
                    <th class="pb-3 font-medium">Tên</th>
                    <th class="pb-3 font-medium">Slug</th>
                    <th class="pb-3 font-medium">Mô tả</th>
                    <th class="pb-3 font-medium w-16">Thứ tự</th>
                    <th class="pb-3 font-medium w-16">SP</th>
                    <th class="pb-3 font-medium w-20">Trạng thái</th>
                    <th class="pb-3 font-medium w-24">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Categories.Any())
                {
                    <tr><td colspan="8" class="py-8 text-center text-gray-400">Chưa có danh mục nào</td></tr>
                }
                @foreach (var cat in Model.Categories)
                {
                    <tr class="border-b border-gray-50 dark:border-gray-800">
                        <td class="py-3"><i class="@cat.IconClass text-primary-500 text-lg"></i></td>
                        <td class="py-3 font-medium text-gray-900 dark:text-white">@cat.Name</td>
                        <td class="py-3 text-gray-500">@cat.Slug</td>
                        <td class="py-3 text-gray-500 max-w-40 truncate">@(cat.Description ?? "—")</td>
                        <td class="py-3 text-gray-500">@cat.SortOrder</td>
                        <td class="py-3 text-gray-500">@cat.Products.Count</td>
                        <td class="py-3">
                            <span class="px-2 py-0.5 rounded-full text-xs @(cat.IsActive ? "bg-green-100 text-green-600" : "bg-red-100 text-red-600")">
                                @(cat.IsActive ? "Hiện" : "Ẩn")
                            </span>
                        </td>
                        <td class="py-3">
                            <div class="flex gap-1">
                                <button type="button" onclick='editCategory(@cat.Id, "@cat.Name", "@cat.Slug", "@(cat.Description ?? "")", "@cat.IconClass", @cat.SortOrder, @(cat.IsActive ? "true" : "false"))'
                                        class="px-2 py-1 text-xs rounded-lg bg-blue-100 text-blue-700 hover:bg-blue-200 transition-colors">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <form method="post" asp-page-handler="Delete" class="inline" style="display:inline">
                                    <input type="hidden" name="id" value="@cat.Id" />
                                    <input type="hidden" name="name" value="@cat.Name" />
                                    <button type="button" onclick="confirmDelete(this)" class="px-2 py-1 text-xs rounded-lg bg-red-100 text-red-700 hover:bg-red-200 transition-colors">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="iconPickerModal" class="fixed inset-0 z-[60] items-center justify-center bg-black/50 modal-overlay">
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 w-full max-w-2xl mx-4 shadow-xl max-h-[80vh] flex flex-col">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Chọn icon</h3>
                <input type="text" id="iconSearch" oninput="filterIcons()" placeholder="Tìm icon..." class="px-3 py-1.5 text-sm border border-gray-200 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-gray-900 focus:ring-2 focus:ring-primary-500 outline-none w-48" />
            </div>
            <div id="iconGrid" class="grid grid-cols-8 gap-2 overflow-y-auto flex-1">
            </div>
            <div class="flex justify-end gap-2 mt-4 pt-4 border-t border-gray-100 dark:border-gray-700">
                <button type="button" onclick="closeIconPicker()" class="px-4 py-2 text-sm rounded-lg bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200">Đóng</button>
            </div>
        </div>
    </div>

    <div id="categoryModal" class="fixed inset-0 z-50 items-center justify-center bg-black/50 modal-overlay">
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 w-full max-w-lg mx-4 shadow-xl">
            <h3 id="modalTitle" class="text-lg font-semibold mb-4 text-gray-900 dark:text-white">Thêm danh mục</h3>
            <form id="categoryForm" method="post">
                <input type="hidden" name="id" id="fieldId" value="0" />
                <div class="space-y-3">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Tên *</label>
                        <input type="text" name="name" id="fieldName" required
                               class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-gray-900 focus:ring-2 focus:ring-primary-500 outline-none" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Slug <span class="text-gray-400 font-normal">(để trống để tự tạo)</span></label>
                        <input type="text" name="slug" id="fieldSlug"
                               class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-gray-900 focus:ring-2 focus:ring-primary-500 outline-none" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Icon</label>
                        <input type="hidden" name="iconClass" id="fieldIcon" value="fas fa-tag" />
                        <div class="flex items-center gap-3 p-3 border border-gray-200 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-gray-900">
                            <div id="iconPreview" class="w-10 h-10 rounded-lg bg-white dark:bg-gray-700 flex items-center justify-center text-primary-500 text-xl">
                                <i class="fas fa-tag"></i>
                            </div>
                            <button type="button" onclick="openIconPicker()" class="px-3 py-1.5 text-sm bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-500 transition-colors">
                                <i class="fas fa-icons mr-1"></i> Chọn icon
                            </button>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Mô tả</label>
                        <textarea name="description" id="fieldDesc" rows="2"
                                  class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-gray-900 focus:ring-2 focus:ring-primary-500 outline-none"></textarea>
                    </div>
                    <div class="flex gap-3">
                        <div class="flex-1">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Thứ tự</label>
                            <input type="number" name="sortOrder" id="fieldSort" value="0"
                                   class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-gray-900 focus:ring-2 focus:ring-primary-500 outline-none" />
                        </div>
                        <div class="flex-1">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Trạng thái</label>
                            <select name="isActive" id="fieldActive"
                                    class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-gray-900 focus:ring-2 focus:ring-primary-500 outline-none">
                                <option value="true">Hiện</option>
                                <option value="false">Ẩn</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="flex justify-end gap-2 mt-5">
                    <button type="button" onclick="hideModal()" class="px-4 py-2 text-sm rounded-lg bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200">Hủy</button>
                    <button type="submit" id="modalSubmit" class="px-4 py-2 text-sm bg-primary-500 text-white rounded-lg hover:bg-primary-600">Thêm</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        const ICONS = [
            "fas fa-tag", "fas fa-tags", "fas fa-star", "fas fa-heart", "fas fa-fire",
            "fas fa-bolt", "fas fa-crown", "fas fa-gem", "fas fa-medal", "fas fa-award",
            "fas fa-utensils", "fas fa-pizza-slice", "fas fa-hamburger", "fas fa-coffee", "fas fa-mug-hot",
            "fas fa-ice-cream", "fas fa-apple-alt", "fas fa-carrot", "fas fa-drumstick-bite", "fas fa-fish",
            "fas fa-mobile-alt", "fas fa-laptop", "fas fa-desktop", "fas fa-tablet-alt", "fas fa-headphones",
            "fas fa-camera", "fas fa-print", "fas fa-tv", "fas fa-plug", "fas fa-battery-full",
            "fas fa-tshirt", "fas fa-shoe-prints", "fas fa-hat-cowboy", "fas fa-glasses", "fas fa-ring",
            "fas fa-book", "fas fa-pen", "fas fa-pencil-alt", "fas fa-palette", "fas fa-music",
            "fas fa-home", "fas fa-couch", "fas fa-bed", "fas fa-chair", "fas fa-lightbulb",
            "fas fa-tools", "fas fa-wrench", "fas fa-hammer", "fas fa-paint-roller", "fas fa-screwdriver",
            "fas fa-car", "fas fa-motorcycle", "fas fa-bicycle", "fas fa-truck", "fas fa-bus",
            "fas fa-futbol", "fas fa-basketball-ball", "fas fa-volleyball-ball", "fas fa-running", "fas fa-swimmer",
            "fas fa-gamepad", "fas fa-chess", "fas fa-dice", "fas fa-puzzle-piece", "fas fa-robot",
            "fas fa-paw", "fas fa-dog", "fas fa-cat", "fas fa-horse", "fas fa-feather",
            "fas fa-flask", "fas fa-microscope", "fas fa-atom", "fas fa-brain", "fas fa-dna",
            "fas fa-leaf", "fas fa-tree", "fas fa-seedling", "fas fa-water", "fas fa-cloud",
            "fas fa-gift", "fas fa-birthday-cake", "fas fa-balloon", "fas fa-candy-cane", "fas fa-champagne-glasses",
            "fas fa-plane", "fas fa-map-marked-alt", "fas fa-compass", "fas fa-suitcase", "fas fa-hiking",
            "fas fa-cogs", "fas fa-microchip", "fas fa-industry", "fas fa-chart-line", "fas fa-calculator",
            "fas fa-phone", "fas fa-envelope", "fas fa-bell", "fas fa-clock", "fas fa-calendar",
            "fas fa-shopping-cart", "fas fa-shopping-bag", "fas fa-shopping-basket", "fas fa-wallet", "fas fa-credit-card",
            "fas fa-oil-can", "fas fa-gas-pump", "fas fa-charging-station", "fas fa-car-battery", "fas fa-tire",
            "fas fa-tooth", "fas fa-heartbeat", "fas fa-stethoscope", "fas fa-pills", "fas fa-vial",
            "fas fa-egg", "fas fa-cheese", "fas fa-bread-slice", "fas fa-pepper-hot", "fas fa-cookie"
        ];

        function openIconPicker() {
            const grid = document.getElementById('iconGrid');
            grid.innerHTML = '';
            ICONS.forEach(icon => {
                const div = document.createElement('div');
                div.className = 'flex items-center justify-center p-3 rounded-lg cursor-pointer hover:bg-primary-50 dark:hover:bg-primary-900/20 border border-transparent hover:border-primary-300 transition-all icon-option';
                div.dataset.icon = icon;
                div.innerHTML = '<i class="' + icon + ' text-lg text-gray-700 dark:text-gray-200"></i>';
                div.onclick = function() { selectIcon(icon); };
                grid.appendChild(div);
            });
            document.getElementById('iconPickerModal').classList.add('show');
            document.getElementById('iconSearch').value = '';
        }

        function closeIconPicker() {
            document.getElementById('iconPickerModal').classList.remove('show');
        }

        function selectIcon(icon) {
            document.getElementById('fieldIcon').value = icon;
            document.getElementById('iconPreview').innerHTML = '<i class="' + icon + '"></i>';
            closeIconPicker();
        }

        function filterIcons() {
            const q = document.getElementById('iconSearch').value.toLowerCase();
            document.querySelectorAll('.icon-option').forEach(el => {
                el.style.display = el.dataset.icon.includes(q) ? '' : 'none';
            });
        }

        document.getElementById('iconPickerModal').addEventListener('click', function (e) {
            if (e.target === this) closeIconPicker();
        });

        function showModal() {
            document.getElementById('modalTitle').textContent = 'Thêm danh mục';
            document.getElementById('categoryForm').action = '?handler=Create';
            document.getElementById('modalSubmit').textContent = 'Thêm';
            document.getElementById('fieldId').value = '0';
            document.getElementById('fieldName').value = '';
            document.getElementById('fieldSlug').value = '';
            document.getElementById('fieldIcon').value = 'fas fa-tag';
            document.getElementById('iconPreview').innerHTML = '<i class="fas fa-tag"></i>';
            document.getElementById('fieldDesc').value = '';
            document.getElementById('fieldSort').value = '0';
            document.getElementById('fieldActive').value = 'true';
            document.getElementById('categoryModal').classList.add('show');
        }
        function editCategory(id, name, slug, desc, icon, sort, active) {
            document.getElementById('modalTitle').textContent = 'Sửa danh mục';
            document.getElementById('categoryForm').action = '?handler=Update';
            document.getElementById('modalSubmit').textContent = 'Cập nhật';
            document.getElementById('fieldId').value = id;
            document.getElementById('fieldName').value = name;
            document.getElementById('fieldSlug').value = slug;
            document.getElementById('fieldIcon').value = icon;
            document.getElementById('iconPreview').innerHTML = '<i class="' + icon + '"></i>';
            document.getElementById('fieldDesc').value = desc;
            document.getElementById('fieldSort').value = sort;
            document.getElementById('fieldActive').value = active ? 'true' : 'false';
            document.getElementById('categoryModal').classList.add('show');
        }
        function hideModal() {
            document.getElementById('categoryModal').classList.remove('show');
        }
        function confirmDelete(btn) {
            const form = btn.closest('form');
            const name = form.querySelector('input[name="name"]').value;
            Swal.fire({
                title: 'Xóa danh mục?',
                text: `Danh mục "${name}" sẽ bị xóa vĩnh viễn.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) form.submit();
            });
        }
        document.getElementById('categoryModal').addEventListener('click', function (e) {
            if (e.target === this) hideModal();
        });
    </script>
}
