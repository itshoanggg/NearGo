@page
@model NearGo.Pages.Admin.FeesModel
@{
    ViewData["Title"] = "Quản lý phí nền tảng";
    Layout = "_AdminLayout";
}
<div class="bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-100 dark:border-gray-700">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Phí nền tảng (@Model.TotalCount)</h2>

    <form method="get" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
        <div>
            <input type="text" name="search" value="@Model.Search" placeholder="Mô tả hoặc mã đơn..." class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-600 rounded-xl bg-gray-50 dark:bg-gray-700 text-sm focus:ring-2 focus:ring-primary-500 outline-none" />
        </div>
        <div>
            <select name="supermarketId" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-600 rounded-xl bg-gray-50 dark:bg-gray-700 text-sm focus:ring-2 focus:ring-primary-500 outline-none">
                <option value="">Tất cả siêu thị</option>
                @foreach (var sm in Model.Supermarkets)
                {
                    <option value="@sm.Id" selected="@(Model.SupermarketId == sm.Id)">@sm.Name</option>
                }
            </select>
        </div>
        <div>
            <select name="feeType" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-600 rounded-xl bg-gray-50 dark:bg-gray-700 text-sm focus:ring-2 focus:ring-primary-500 outline-none">
                <option value="">Tất cả loại phí</option>
                <option value="Commission" selected="@(Model.FeeType == "Commission")">Hoa hồng</option>
            </select>
        </div>
        <div>
            <select name="status" class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-600 rounded-xl bg-gray-50 dark:bg-gray-700 text-sm focus:ring-2 focus:ring-primary-500 outline-none">
                <option value="">Tất cả trạng thái</option>
                <option value="Paid" selected="@(Model.Status == "Paid")">Đã thu</option>
                <option value="Pending" selected="@(Model.Status == "Pending")">Chờ thu</option>
            </select>
        </div>
        <div class="flex gap-2">
            <button type="submit" class="flex-1 px-4 py-2.5 bg-primary-500 text-white text-sm font-medium rounded-xl hover:bg-primary-600 transition-colors">
                <i class="fas fa-filter mr-1"></i> Lọc
            </button>
            <a href="/admin/fees" class="px-4 py-2.5 border border-gray-200 dark:border-gray-600 text-gray-500 text-sm rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                <i class="fas fa-undo"></i>
            </a>
        </div>
    </form>

    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="text-left text-gray-500 border-b border-gray-100 dark:border-gray-700">
                    <th class="pb-3 font-medium">Siêu thị</th>
                    <th class="pb-3 font-medium">Loại phí</th>
                    <th class="pb-3 font-medium">Số tiền</th>
                    <th class="pb-3 font-medium">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Fees.Any())
                {
                    <tr><td colspan="4" class="py-8 text-center text-gray-400">Không có phí nào</td></tr>
                }
                @foreach (var f in Model.Fees)
                {
                    <tr class="border-b border-gray-50 dark:border-gray-800">
                        <td class="py-3 text-gray-900 dark:text-white">@f.Supermarket?.Name</td>
                        <td class="py-3 text-gray-500">@(f.FeeType == "Commission" ? "Hoa hồng" : f.FeeType)</td>
                        <td class="py-3 text-gray-900 dark:text-white font-medium">@f.Amount.ToString("N0")đ</td>
                        <td class="py-3">
                            <span class="px-2 py-0.5 rounded-full text-xs @(f.Status == "Paid" ? "bg-green-100 text-green-600" : "bg-yellow-100 text-yellow-600")">
                                @(f.Status == "Paid" ? "Đã thu" : "Chờ thu")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-center gap-2 mt-6">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a href="@Url.Page("Fees", new { p = i, search = Model.Search, status = Model.Status, feeType = Model.FeeType, supermarketId = Model.SupermarketId })"
                    class="px-3 py-1.5 text-sm rounded-lg @(i == Model.CurrentPage ? "bg-primary-500 text-white" : "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600")">
                    @i
                </a>
            }
        </div>
    }
</div>
